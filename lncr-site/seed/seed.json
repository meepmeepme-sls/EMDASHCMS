    "wiki": [
      {
        "id": "wiki-tt-instructions",
        "slug": "tropical-trouble-instructions",
        "status": "published",
        "data": {
          "title": "Tropical Trouble Instructions Booklet",
          "category": "Kit Build Guides",
          "guide_version": "Version 1 Revision 2",
          "updated_date": "November 20, 2025",
          "cadasio_url": "https://instructions.online/?id=16518-tropical%20trouble%20kit%20rev%204",
          "kit_url": "/products/tt-kit",
          "featured_image": "/products/tt-kit-1.jpg",
          "excerpt": "Complete bill of materials, Cadasio 3D hardware assembly, wiring diagram, smoke-stopper checklist, and Bambu Studio TPU/PLA slicer settings for the 3lb Tropical Trouble beetleweight kit.",
          "content": [
            {
              "_type": "block",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "text": "A Word on Safety",
                  "_key": "k_vly43yt"
                }
              ],
              "_key": "b_gn644yg"
            },
            {
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "Tropical Trouble, like all kinetic energy weaponized combat robots, can be extremely dangerous. The kit includes a secondary weapon bolt and nylock nut that acts as your dedicated weapon lock. Paint it high-visibility orange or add a bright ribbon. Never power on the robot without the weapon lock firmly installed.",
                  "_key": "k_70arq1q"
                }
              ],
              "_key": "b_6tqvphf"
            },
            {
              "_type": "block",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "text": "Hardware Assembly & Interactive 3D Guide",
                  "_key": "k_41wkani"
                }
              ],
              "_key": "b_r7rk4xf"
            },
            {
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "Interactive 3D assembly instructions are available online at Cadasio (https://instructions.online/?id=16518-tropical%20trouble%20kit%20rev%204) where you can rotate, explode, and inspect every screw, bearing, and belt in 3D.",
                  "_key": "k_5fz526n"
                }
              ],
              "_key": "b_52v71xk"
            },
            {
              "_type": "block",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "text": "Electronics & Wiring Layout",
                  "_key": "k_lacspxw"
                }
              ],
              "_key": "b_484qpl5"
            },
            {
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "Connect your Repeat AM32 Dual ESC to the 2x Repeat Max 2006 drive motors. Wire the HGLRC SPECTER 90A ESC to the Repeat 2812 800KV hubmotor. Use a ViFly ShortSaver V2 Smart Smoke Stopper before the initial power-on test to verify polarities and eliminate solder short risks.",
                  "_key": "k_g6kp5u1"
                }
              ],
              "_key": "b_21dwy5o"
            },
            {
              "_type": "block",
              "style": "h2",
