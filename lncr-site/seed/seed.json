      {
        "id": "prod-tt-kit",
        "slug": "tt-kit",
        "status": "published",
        "data": {
          "title": "Tropical Trouble 3lb Combat Robot Kit",
          "price": 140,
          "badge": "coming_soon",
          "badge_label": "Coming Soon",
          "category_slug": "robot-kits",
          "category_name": "Robot Kits",
          "featured": true,
          "featured_image": "/products/tt-kit-1.jpg",
          "images_json": "[\"/products/tt-kit-1.jpg\",\"/products/tt-kit-2.jpg\",\"/products/tt-kit-3.png\",\"/products/tt-kit-4.jpg\",\"/products/tt-kit-5.jpg\"]",
          "options_json": "[{\"name\":\"Receiver Option\",\"values\":[\"No Receiver (Bring Your Own)\",\"Include Radiomaster ER4 ELRS (+$20)\"]}]",
          "excerpt": "Complete 3lb Beetleweight 4WD Vertical Spinner Combat Robot Kit.",
          "description": [
            {
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "Tropical Trouble is an affordable, customizable, and competitive 3lb combat robot kit. Based on the 2024 MRCA Champion Pipeline Punch and placing in the Top 8 at NHRL March 2025, Tropical Trouble lowers the barrier to insect-weight combat robotics without compromising hitting power or durability.",
                  "_key": "k_xgr96qe"
                }
              ],
              "_key": "b_nrrext4"
            },
            {
              "_type": "block",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "text": "Key Specifications",
                  "_key": "k_vtxkz0q"
                }
              ],
              "_key": "b_7uavjo2"
            },
            {
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "• Weight Class: 3lb Beetleweight (SPARC and NHRL compliant)",
                  "_key": "k_a4076wf"
                }
              ],
              "_key": "b_pdzvkgn"
            },
            {
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "• Drivetrain: 4WD cast 45A Urethane wheels with Repeat Max 2006 (7.4 MPH top speed)",
                  "_key": "k_isjs0vh"
                }
              ],
              "_key": "b_tfovcsu"
            },
            {
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "• Weapon: 6\" effective diameter, 217 MPH tip speed driven by Repeat Robotics 2812 Hubmotor",
                  "_key": "k_a45kb5r"
                }
              ],
              "_key": "b_rlm3ghy"
            },
            {
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "• Battery: Designed for GNB 4S 850mAh 120C LiHV — 3+ minutes continuous runtime",
                  "_key": "k_134vpik"
                }
              ],
              "_key": "b_pkm9l44"
            },
            {
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "• Chassis: 100% 3D-printable 95A TPU unibody, TPU wheel guards, and modular forks",
                  "_key": "k_9tljghx"
                }
              ],
              "_key": "b_fgoa134"
            },
            {
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "This listing contains 3D printed parts, a hardware kit (screws, hubmotor bolts & weapon lock), timing belts, and wheels. Estimated total build price is $440 depending on electronics.",
                  "_key": "k_9gghqon"
                }
              ],
              "_key": "b_j2tb2fu"
            }
          ],
          "specs_json": "{\"Weight Class\":\"3lb Beetleweight\",\"Drivetrain\":\"4WD Indirect Belt Drive (Cast 45A Urethane)\",\"Drive Motors\":\"2x Repeat Max 2006 (Brushed/Brushless compatible)\",\"Weapon\":\"6\\\" AR500 Dual Disks (217 MPH tip speed)\",\"Weapon Motor\":\"Repeat Robotics 2812 800KV Hubmotor\",\"Chassis Material\":\"95A High-Flow TPU\",\"Battery Spec\":\"4S 850mAh 120C LiHV (XT30)\"}"
        }
      },
