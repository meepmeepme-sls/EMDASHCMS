---
import { getEmDashCollection } from "emdash";
import CosmosLayout from "../../layouts/CosmosLayout.astro";

const { entries: allProducts } = await getEmDashCollection("products", {
  orderBy: { created_at: "asc" },
  limit: 50,
});

const currentCategory = Astro.url.searchParams.get("category") || "all";

const categories = [
  { slug: "all", name: "All", href: "/products" },
  { slug: "robot-kits", name: "Robot Kits", href: "/products?category=robot-kits" },
  { slug: "parts-wheels", name: "Parts & Wheels", href: "/products?category=parts-wheels" },
  { slug: "digital-files", name: "Digital Files", href: "/products?category=digital-files" },
  { slug: "merch", name: "Merch", href: "/products?category=merch" },
];

const filteredProducts = currentCategory === "all"
  ? allProducts
  : allProducts.filter((p) => p.data.category_slug === currentCategory);
---

<CosmosLayout title="Products" pageType="products" description="Affordable Kits and parts for insect-weight combat robotics">
  <div class="content-wrapper content-wrapper--products" data-bc-hook="content">
    <div class="products-header">
      <h1 class="page-title">Products</h1>
      <nav class="category-navigation" aria-label="Browse categories">
        <ul>
          {categories.map((cat) => {
            const isCurrent = currentCategory === cat.slug;
            return (
              <li>
                <a class={isCurrent ? "current" : ""} href={cat.href}>
                  {cat.name}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>
    </div>

    <div class="product-list-container">
      {filteredProducts.length === 0 ? (
        <div class="custom-page" style="text-align: center; padding: 40px 0;">
          <p style="font-size: 1.1rem; color: var(--header-text-color);">No products found in this category.</p>
          <a href="/products" class="button" style="display: inline-block; margin-top: 16px;">View all products</a>
        </div>
      ) : (
        <div class="product-list">
          {filteredProducts.map((p) => {
            const badgeLabel = p.data.badge_label || (p.data.badge === "coming_soon" ? "Coming Soon" : "");
            return (
              <div class="product-list-thumb product">
                <a class="product-list-link product-list-link--under_image" href={`/products/${p.slug}`} title={`View ${p.data.title}`}>
                  <div class="product-list-image-container product-list-image-container-cover">
                    {badgeLabel && (
                      <div class="product-list-thumb-status status-primary">
                        {badgeLabel}
                      </div>
                    )}
                    <img
                      alt=""
                      class="product-list-image grid-cover"
                      src={p.data.featured_image || "/images/lncr-logo.png"}
                      loading="lazy"
                    />
                  </div>
                  <div class="product-list-thumb-info">
                    <div class="product-list-thumb-name">{p.data.title}</div>
                    <div class="product-list-thumb-price">
                      <span class="currency_sign">$</span>{Number(p.data.price).toFixed(2)}
                    </div>
                  </div>
                </a>
              </div>
            );
          })}
        </div>
      )}
    </div>
  </div>
</CosmosLayout>
