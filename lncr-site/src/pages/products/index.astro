---
import { getEmDashCollection } from "emdash";
import CosmosLayout from "../../layouts/CosmosLayout.astro";

const { entries: allProducts } = await getEmDashCollection("products", {
  orderBy: { created_at: "asc" },
  limit: 50,
});

const currentCategory = Astro.url.searchParams.get("category") || "all";

const categories = [
  { slug: "all", name: "All Products" },
  { slug: "robot-kits", name: "Robot Kits" },
  { slug: "parts-wheels", name: "Parts & Wheels" },
  { slug: "digital-files", name: "Digital Files" },
  { slug: "merch", name: "Merch" },
];

const filteredProducts = currentCategory === "all"
  ? allProducts
  : allProducts.filter((p) => p.data.category_slug === currentCategory);
---

<CosmosLayout title="Products" description="Late Night Combat Robotics Store — Robot Kits, CAD Files, Replacement Parts & Apparel.">
  <div class="content-wrapper" style="max-width:1240px; margin:0 auto 60px auto; padding:0 24px;">
    <!-- Page Header -->
    <header class="page-header" style="text-align:center; margin-bottom:36px; padding-top:20px;">
      <h1 class="page-title" style="font-family:var(--primary-font); font-size:2.2rem; font-weight:700; color:var(--header-text-color); margin-bottom:8px;">
        Products
      </h1>
      <p style="color:var(--text-color); font-size:1rem; max-width:600px; margin:0 auto;">
        Official combat robot kits, replacement components, CAD downloads, and team apparel.
      </p>
    </header>

    <!-- Category Filter Tabs -->
    <nav aria-label="Product Category Filter" style="display:flex; justify-content:center; gap:8px; flex-wrap:wrap; margin-bottom:36px;">
      {categories.map((cat) => {
        const isActive = currentCategory === cat.slug;
        const href = cat.slug === "all" ? "/products" : `/products?category=${cat.slug}`;
        return (
          <a
            href={href}
            class="filter-tab"
            style={`
              padding: 8px 16px;
              font-family: var(--primary-font);
              font-size: 0.85rem;
              font-weight: 600;
              text-decoration: none;
              border: 1px solid #3D4B59;
              background: ${isActive ? "#094AD8" : "#fff"};
              color: ${isActive ? "#fff" : "var(--header-text-color)"};
              transition: all 0.15s ease;
            `}
          >
            {cat.name}
          </a>
        );
      })}
    </nav>

    <!-- Products Grid -->
    {filteredProducts.length === 0 ? (
      <div style="text-align:center; padding:60px 20px; background:#fff; border:1px solid #3D4B59;">
        <p style="font-family:var(--primary-font); font-size:1.1rem; color:var(--header-text-color);">No products found in this category.</p>
        <a href="/products" style="color:#094AD8; font-weight:600; text-decoration:none; margin-top:8px; display:inline-block;">View all products &rarr;</a>
      </div>
    ) : (
      <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(280px, 1fr)); gap:24px;">
        {filteredProducts.map((p) => {
          const badgeLabel = p.data.badge_label || (p.data.badge === "coming_soon" ? "Coming Soon" : "");
          return (
            <div class="product-card" style="background:#fff; border:1px solid #3D4B59; display:flex; flex-direction:column; overflow:hidden;">
              <a href={`/products/${p.slug}`} style="text-decoration:none; color:inherit; display:flex; flex-direction:column; height:100%;">
                <div style="position:relative; aspect-ratio:1/1; background:#f9fafb; overflow:hidden;">
                  {badgeLabel && (
                    <div style="position:absolute; top:12px; left:12px; background:#67C3E8; color:#1F2937; font-family:var(--primary-font); font-size:0.75rem; font-weight:700; padding:4px 8px; text-transform:uppercase; z-index:2;">
                      {badgeLabel}
                    </div>
                  )}
                  <img
                    src={p.data.featured_image || "/images/lncr-logo.png"}
                    alt={p.data.title}
                    loading="lazy"
                    style="width:100%; height:100%; object-fit:cover;"
                  />
                </div>
                <div style="padding:16px; display:flex; flex-direction:column; flex:1; justify-content:space-between; gap:12px;">
                  <div>
                    <h2 style="font-family:var(--primary-font); font-size:0.95rem; font-weight:700; color:var(--header-text-color); margin-bottom:6px; line-height:1.3;">
                      {p.data.title}
                    </h2>
                    <div style="font-family:var(--primary-font); font-size:0.95rem; font-weight:700; color:var(--text-color);">
                      ${Number(p.data.price).toFixed(2)}
                    </div>
                  </div>
                  <span class="button" style="background:#094AD8; color:#fff; text-align:center; padding:8px 16px; font-family:var(--primary-font); font-size:0.8rem; font-weight:700; text-transform:uppercase;">
                    View Details
                  </span>
                </div>
              </a>
            </div>
          );
        })}
      </div>
    )}
  </div>
</CosmosLayout>
