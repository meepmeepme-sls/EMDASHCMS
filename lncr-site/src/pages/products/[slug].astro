---
import { getEmDashEntry, decodeSlug } from "emdash";
import { PortableText } from "emdash/ui";
import CosmosLayout from "../../layouts/CosmosLayout.astro";

const slug = decodeSlug(Astro.params.slug);
if (!slug) {
  return Astro.rewrite("/404");
}

const { entry: product, cacheHint } = await getEmDashEntry("products", slug);
if (!product) {
  return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const pData = product.data;
let images: string[] = [];
try {
  images = pData.images_json ? JSON.parse(pData.images_json) : [pData.featured_image || "/images/lncr-logo.png"];
} catch {
  images = [pData.featured_image || "/images/lncr-logo.png"];
}

let options: Array<{ name: string; values: string[] }> = [];
try {
  if (pData.options_json) {
    options = typeof pData.options_json === "string" ? JSON.parse(pData.options_json) : pData.options_json;
  }
} catch {
  options = [];
}

const isComingSoon = pData.badge === "coming_soon";
---

<CosmosLayout title={pData.title} pageType="product" description={pData.excerpt || pData.title}>
  <div class="content-wrapper content-wrapper--product" data-bc-hook="content">
    <div class="product-container" data-bc-hook="product-container">
      <!-- Product Images Carousel (Cosmos Exact Structure) -->
      <div class="product-images desktop-carousel mobile-show-thumbnails" data-total-images={images.length}>
        <div class="zoom-image-container gallery-link">
          <img
            id="main-product-image"
            alt={pData.title}
            class="product-image"
            fetchpriority="high"
            src={images[0]}
          />
        </div>

        {images.length > 1 && (
          <div class="product-thumbnails" style="display:flex; gap:10px; margin-top:14px; flex-wrap:wrap;">
            {images.map((img, idx) => (
              <button
                type="button"
                class="thumb-btn"
                data-img-src={img}
                style="width:72px; height:72px; padding:0; border:1px solid var(--border-color, #3D4B59); background:#fff; cursor:pointer; overflow:hidden;"
                aria-label={`View photo ${idx + 1}`}
              >
                <img src={img} alt="" style="width:100%; height:100%; object-fit:cover;" />
              </button>
            ))}
          </div>
        )}
      </div>

      <!-- Product Detail (Cosmos Exact Structure) -->
      <section class="product-detail">
        <div class="product-detail__header">
          <h1 class="page-title page-title--left product-detail__title">{pData.title}</h1>
          <div class="product-detail__pricing">
            <span><span class="currency_sign">$</span>{Number(pData.price).toFixed(2)}</span>
          </div>
        </div>

        <form id="add-to-cart-form" method="post" class="product-form show-sold-out" action="/products">
          {options.map((opt) => (
            <div class="select">
              <select name="option" aria-label={opt.name}>
                {opt.values.map((v) => (
                  <option value={v}>{v}</option>
                ))}
              </select>
              <svg aria-hidden="true" fill="currentColor" width="14" height="8" viewBox="0 0 14 8">
                <path d="M1 1l6 6 6-6" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" />
              </svg>
            </div>
          ))}

          {isComingSoon ? (
            <button id="add-to-cart-button" class="button add-to-cart-button" type="button" disabled style="opacity:0.75; cursor:not-allowed;">
              Coming Soon
            </button>
          ) : (
            <button id="add-to-cart-button" class="button add-to-cart-button" type="submit">
              Add to cart
            </button>
          )}

          {pData.google_drive_url && (
            <p style="font-size:0.85rem; color:var(--text-color); margin-top:10px;">
              &check; Instant Google Drive delivery upon checkout
            </p>
          )}
        </form>

        <div class="product-detail__description">
          {pData.description && Array.isArray(pData.description) ? (
            <PortableText value={pData.description} />
          ) : (
            <p>{pData.description}</p>
          )}
        </div>
      </section>
    </div>
  </div>

  <style>
    .product-detail__pricing {
      font-size: calc(2rem * var(--product-title-scale, 1)) !important;
      font-weight: 700;
      color: var(--header-text-color);
    }
    .add-to-cart-button {
      padding: 14px 28px !important;
      font-size: 0.95rem !important;
      font-weight: 700;
      max-width: 320px;
    }
  </style>

  <script>
    const mainImg = document.getElementById('main-product-image') as HTMLImageElement;
    const thumbBtns = document.querySelectorAll('.thumb-btn');
    thumbBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetSrc = btn.getAttribute('data-img-src');
        if (targetSrc && mainImg) {
          mainImg.src = targetSrc;
        }
      });
    });
  </script>
</CosmosLayout>
