---
import CosmosLayout from "../layouts/CosmosLayout.astro";
import CalculatorApp from "../components/calculator/App";
import "../styles/calculator.css";
---

<CosmosLayout
  title="Combat Robotics Engineering Calculator"
  pageType="calculator"
  description="Native modular combat robotics calculators for drivetrain speed, weapon kinetic energy, electronics spin-up, center distance, and battery sizing with SPARC & NHRL compliance."
>
  <div class="content-wrapper content-wrapper--calculator" style="max-width: 1400px; margin: 0 auto 60px auto; padding: 0 16px;">
    <div class="lncr-calculator-root">
      <CalculatorApp client:load />
    </div>
  </div>
</CosmosLayout>
