---
import { getEmDashCollection } from "emdash";
import CosmosLayout from "../layouts/CosmosLayout.astro";

const [productsResult, wikiResult, postsResult] = await Promise.all([
  getEmDashCollection("products", { limit: 20 }),
  getEmDashCollection("wiki", { limit: 10 }),
  getEmDashCollection("posts", { limit: 5 }),
]);

const products = productsResult.entries;
const guides = wikiResult.entries;
const posts = postsResult.entries;

// Display featured products in the exact Cosmos order
const featuredProducts = products.filter((p) => p.data.featured);
---

<CosmosLayout title="Home" pageType="home">
  <div class="content-wrapper content-wrapper--home" data-bc-hook="content">
    <div class="home-content">
      <!-- 1. Featured Products (Exact Big Cartel Cosmos Alternating Layout) -->
      <div class="home-featured-products">
        <div class="featured-container">
          <h1 class="featured-title">Featured</h1>
        </div>

        <div class="product-list-container">
          <div class="product-list product-list--alternating">
            {featuredProducts.map((p) => {
              const badgeLabel = p.data.badge_label || (p.data.badge === "coming_soon" ? "Coming Soon" : "");
              return (
                <div class="product-list-thumb product">
                  <a class="product-list-link original-dimensions" href={`/products/${p.slug}`} title={p.data.title}>
                    <div class="product-list-image-container product-list-image-container-cover">
                      {badgeLabel && (
                        <div class="product-list-thumb-status status-primary">
                          {badgeLabel}
                        </div>
                      )}
                      <img
                        alt={p.data.title}
                        class="product-list-image grid-cover"
                        src={p.data.featured_image || "/images/lncr-logo.png"}
                        loading="lazy"
                      />
                    </div>
                    <div class="product-list-thumb-info">
                      <div class="product-list-thumb-name">{p.data.title}</div>
                      <div class="product-list-thumb-price">
                        <span class="currency_sign">$</span>{Number(p.data.price).toFixed(2)}
                      </div>
                      <span class="button product-list-shop-now">Shop</span>
                    </div>
                  </a>
                </div>
              );
            })}
          </div>
        </div>
      </div>

      <a class="button button--centered button--secondary all-products-button" href="/products">
        All products
      </a>

      <!-- 2. Engineering & Builder Tools (Unified with Cosmos Tokens) -->
      <section style="margin-top: 80px; padding-top: 40px; border-top: 1px solid var(--border-color, #3D4B59);">
        <div class="featured-container" style="text-align: center; margin-bottom: 32px;">
          <h2 class="featured-title" style="font-size: 1.5rem; margin-bottom: 8px;">Engineering &amp; Builder Tools</h2>
          <p style="color: var(--text-color); font-size: 0.95rem; max-width: 680px; margin: 0 auto;">
            Open-source engineering calculation tools and step-by-step build documentation for insect-weight combat robotics.
          </p>
        </div>

        <div class="product-list-container">
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 32px;">
            <!-- Combat Calculator Card -->
            <div style="border: 1px solid var(--border-color, #3D4B59); background: #fff; padding: 28px; display: flex; flex-direction: column; justify-content: space-between;">
              <div>
                <span style="font-size: 0.75rem; font-weight: 700; color: #67C3E8; background: #2B3A4A; padding: 3px 8px; text-transform: uppercase; display: inline-block; margin-bottom: 12px;">
                  Interactive Tool
                </span>
                <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--header-text-color); margin-bottom: 10px;">
                  Combat Robotics Calculator
                </h3>
                <p style="color: var(--text-color); font-size: 0.92rem; line-height: 1.6; margin-bottom: 16px;">
                  7-in-1 calculation suite for Drivetrain top speed, Weapon KE &amp; Tip Speed, Spin-Up times, Capacitance, Battery Runtime, and Timing Belts.
                </p>
              </div>
              <a href="/calculator" class="button" style="text-align: center; text-decoration: none; margin-top: 12px;">
                Launch Calculator &rarr;
              </a>
            </div>

            <!-- Engineering Wiki Card -->
            <div style="border: 1px solid var(--border-color, #3D4B59); background: #fff; padding: 28px; display: flex; flex-direction: column; justify-content: space-between;">
              <div>
                <span style="font-size: 0.75rem; font-weight: 700; color: #67C3E8; background: #2B3A4A; padding: 3px 8px; text-transform: uppercase; display: inline-block; margin-bottom: 12px;">
                  Build Manuals
                </span>
                <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--header-text-color); margin-bottom: 10px;">
                  Engineering Documentation Wiki
                </h3>
                <p style="color: var(--text-color); font-size: 0.92rem; line-height: 1.6; margin-bottom: 16px;">
                  Official bill of materials, interactive 3D assembly on Cadasio, wiring layout diagrams, and Bambu Studio TPU modifier slicing profiles.
                </p>
              </div>
              <a href="/wiki" class="button" style="text-align: center; text-decoration: none; margin-top: 12px;">
                View Documentation &rarr;
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- 3. From the Workbench Blog -->
      {posts.length > 0 && (
        <section style="margin-top: 60px; padding-top: 40px; border-top: 1px solid var(--border-color, #3D4B59);">
          <div class="featured-container" style="text-align: center; margin-bottom: 24px;">
            <h2 class="featured-title" style="font-size: 1.35rem; margin-bottom: 6px;">From the Workbench</h2>
          </div>
          <div style="max-width: 840px; margin: 0 auto; border: 1px solid var(--border-color, #3D4B59); background: #fff; padding: 32px;">
            <a href={`/blog/${posts[0].slug}`} style="text-decoration: none; color: inherit;">
              <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--header-text-color); margin-bottom: 12px; line-height: 1.3;">
                {posts[0].data.title}
              </h3>
              <p style="color: var(--text-color); font-size: 0.95rem; line-height: 1.6; margin-bottom: 16px;">
                {posts[0].data.excerpt}
              </p>
              <span style="font-weight: 700; color: var(--header-text-color);">
                Read Article &rarr;
              </span>
            </a>
          </div>
        </section>
      )}
    </div>
  </div>
</CosmosLayout>
