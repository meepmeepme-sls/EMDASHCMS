---
import CosmosLayout from "../layouts/CosmosLayout.astro";
---

<CosmosLayout title="Page not found" pageType="404" description="The page you are looking for does not exist.">
  <div class="content-wrapper content-wrapper--404" data-bc-hook="content">
    <div class="custom-page" style="text-align: center; padding: 60px 24px;">
      <h1 class="page-title">Page Not Found</h1>
      <div class="custom-page--content">
        <p style="font-size: 1.1rem; margin-bottom: 24px;">
          The page you requested could not be found. It may have moved or been updated.
        </p>
        <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
          <a href="/" class="button">Home &rarr;</a>
          <a href="/products" class="button button--secondary">View Products &rarr;</a>
          <a href="/wiki" class="button button--secondary">Engineering Wiki &rarr;</a>
          <a href="/calculator" class="button button--secondary">Calculator &rarr;</a>
        </div>
      </div>
    </div>
  </div>
</CosmosLayout>
