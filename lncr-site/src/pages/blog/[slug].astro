---
import { getEmDashEntry, decodeSlug } from "emdash";
import { PortableText } from "emdash/ui";
import CosmosLayout from "../../layouts/CosmosLayout.astro";

const slug = decodeSlug(Astro.params.slug);
if (!slug) {
  return Astro.rewrite("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);
if (!post) {
  return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const pData = post.data;
---

<CosmosLayout title={pData.title} pageType="blog-post" description={pData.excerpt || pData.title}>
  <div class="content-wrapper content-wrapper--blog-post" data-bc-hook="content" style="max-width: 880px; margin: 0 auto 60px auto; padding: 0 var(--side-padding, 24px);">
    <!-- Breadcrumb -->
    <nav class="product-breadcrumb" aria-label="Breadcrumb" style="font-size: 0.85rem; margin-bottom: 24px; color: var(--text-color);">
      <a href="/" style="color: var(--header-text-color); text-decoration: none;">Home</a> /
      <a href="/blog" style="color: var(--header-text-color); text-decoration: none;">Blog</a> /
      <span style="color: var(--text-color); opacity: 0.7;">{pData.title}</span>
    </nav>

    <article style="background: #fff; border: 1px solid var(--border-color); padding: 40px;">
      <header style="margin-bottom: 28px; border-bottom: 1px solid var(--border-color); padding-bottom: 20px;">
        <h1 style="font-family: var(--primary-font); font-size: 1.85rem; font-weight: 700; color: var(--header-text-color); line-height: 1.25; margin-bottom: 12px;">
          {pData.title}
        </h1>
        {pData.excerpt && (
          <p style="font-size: 1.05rem; line-height: 1.5; color: var(--text-color); margin: 0;">
            {pData.excerpt}
          </p>
        )}
      </header>

      {/* Embedded YouTube Fight Video if from-pipeline-punch-to-tropical-trouble */}
      {slug === "from-pipeline-punch-to-tropical-trouble" && (
        <div style="position: relative; aspect-ratio: 16/9; margin-bottom: 32px; border: 1px solid var(--border-color); overflow: hidden;">
          <iframe
            src="https://www.youtube.com/embed/nfh8qXnf3j0"
            title="Tropical Trouble at 2025 SEMO St Charles Quad Con"
            style="width: 100%; height: 100%; border: 0;"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      )}

      <!-- Article Body -->
      <div class="custom-page--content" style="font-size: 1rem; line-height: 1.75; color: var(--text-color);">
        {pData.content && Array.isArray(pData.content) ? (
          <PortableText value={pData.content} />
        ) : (
          <p>{pData.content}</p>
        )}
      </div>

      <!-- Action Footer -->
      <div style="margin-top: 40px; padding-top: 24px; border-top: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
        <a href="/blog" style="color: var(--header-text-color); font-weight: 600; text-decoration: none;">
          &larr; Back to all posts
        </a>
        <a href="/calculator" class="button">
          Try the LNCR Calculator &rarr;
        </a>
      </div>
    </article>
  </div>
</CosmosLayout>
