---
import { getEmDashCollection } from "emdash";
import CosmosLayout from "../../layouts/CosmosLayout.astro";

const { entries: posts } = await getEmDashCollection("posts", {
  orderBy: { created_at: "desc" },
  limit: 20,
});
---

<CosmosLayout title="Blog" description="Engineering build reports, competition tournament retrospectives, and combat robot design notes from Late Night Combat Robotics.">
  <div class="content-wrapper" style="max-width:960px; margin:0 auto 60px auto; padding:0 24px;">
    <!-- Page Header -->
    <header style="text-align:center; margin-bottom:40px; padding-top:20px;">
      <h1 style="font-family:var(--primary-font); font-size:2.2rem; font-weight:700; color:var(--header-text-color); margin-bottom:10px;">
        Engineering &amp; Competition Blog
      </h1>
      <p style="color:var(--text-color); font-size:1rem; line-height:1.5;">
        Tournament match breakdowns, lessons learned from Norwalk Havoc, and beetleweight development logs.
      </p>
    </header>

    <div style="display:flex; flex-direction:column; gap:32px;">
      {posts.map((post) => (
        <article style="background:#fff; border:1px solid #3D4B59; overflow:hidden; display:flex; flex-direction:column;">
          {post.data.featured_image && (
            <div style="aspect-ratio:21/9; overflow:hidden; background:#16181D;">
              <img
                src={post.data.featured_image}
                alt={post.data.title}
                loading="lazy"
                style="width:100%; height:100%; object-fit:cover;"
              />
            </div>
          )}
          <div style="padding:32px;">
            <h2 style="font-family:var(--primary-font); font-size:1.4rem; font-weight:700; color:var(--header-text-color); line-height:1.3; margin-bottom:12px;">
              <a href={`/blog/${post.slug}`} style="text-decoration:none; color:inherit;">
                {post.data.title}
              </a>
            </h2>
            <p style="color:#4B5563; font-size:0.95rem; line-height:1.6; margin-bottom:20px;">
              {post.data.excerpt}
            </p>
            <a
              href={`/blog/${post.slug}`}
              class="button"
              style="background:#094AD8; color:#fff; font-family:var(--primary-font); font-size:0.8rem; font-weight:700; text-transform:uppercase; padding:8px 18px; text-decoration:none; display:inline-block; border-radius:0;"
            >
              Read Article &rarr;
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</CosmosLayout>
