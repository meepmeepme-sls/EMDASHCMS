---
import { getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import CosmosLayout from "../layouts/CosmosLayout.astro";

const { entry: page } = await getEmDashEntry("pages", "about");
---

<CosmosLayout title="About" pageType="about" description="About Late Night Combat Robotics — Lowering barriers to combat robotics with competition kits, calculators, and documentation.">
  <div class="content-wrapper content-wrapper--about" data-bc-hook="content">
    <div class="custom-page">
      <h1 class="page-title">About</h1>
      <div class="custom-page--content">
        {page?.data?.content ? (
          <PortableText value={page.data.content} />
        ) : (
          <div>
            <p>I am a mechanical engineer specializing in product design.</p>
            <p>I am looking to use my engineering experience to lower barriers in combat robotics.</p>
            <p>Late Night Combat Robotics designs competition-proven combat robot kits, open-source engineering calculators, and technical build documentation to help new and experienced builders get into combat robotics with confidence.</p>
          </div>
        )}

        <div style="margin-top: 48px; padding-top: 32px; border-top: 1px solid var(--border-color);">
          <h2 style="font-size: 1.25rem; font-weight: 700; color: var(--header-text-color); margin-bottom: 12px;">Connect with the Community</h2>
          <p style="margin-bottom: 24px;">
            Have questions about Tropical Trouble or need advice on your combat robot design? Join our Discord or check out fight breakdown videos on YouTube.
          </p>
          <div style="display: flex; gap: 16px; flex-wrap: wrap;">
            <a href="https://discord.gg/JAwngFmVEq" target="_blank" rel="noopener" class="button button--secondary">
              Discord Community &rarr;
            </a>
            <a href="https://www.youtube.com/@LateNightCombatRobotics" target="_blank" rel="noopener" class="button">
              YouTube Channel &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</CosmosLayout>
