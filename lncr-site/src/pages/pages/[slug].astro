---
import {
  getEmDashEntry,
  getSeoMeta,
  decodeSlug,
  getSiteSettings,
} from "emdash";
import { PortableText } from "emdash/ui";
import CosmosLayout from "../../layouts/CosmosLayout.astro";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
  return Astro.rewrite("/404");
}

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug);

if (!page) {
  return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());
const seo = getSeoMeta(page, {
  siteTitle,
  siteUrl: Astro.url.origin,
  path: Astro.url.pathname.replace(/\/$/, ""),
});
---

<CosmosLayout
  title={seo.title || page.data.title}
  pageType="page"
  description={seo.description || page.data.title}
>
  <div class="content-wrapper content-wrapper--page" data-bc-hook="content">
    <div class="custom-page">
      <h1 class="page-title">{page.data.title}</h1>
      <div class="custom-page--content">
        {page.data.content ? (
          <PortableText value={page.data.content} />
        ) : null}
      </div>
    </div>
  </div>
</CosmosLayout>
