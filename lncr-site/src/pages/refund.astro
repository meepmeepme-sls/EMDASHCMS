---
import { getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import CosmosLayout from "../layouts/CosmosLayout.astro";

const { entry: page } = await getEmDashEntry("pages", "refund");
---

<CosmosLayout title="Returns and refunds" pageType="page" description="Returns and refund policy for Late Night Combat Robotics physical kit hardware and digital CAD downloads.">
  <div class="content-wrapper content-wrapper--refund" data-bc-hook="content">
    <div class="custom-page">
      <h1 class="page-title">Returns and refunds</h1>
      <div class="custom-page--content">
        {page?.data?.content ? (
          <PortableText value={page.data.content} />
        ) : (
          <div>
            <p>All sales are final. Returns and refunds of fulfilled digital or physical purchases will not be accepted.</p>
            <p>If there is an issue with your kit, missing hardware, or damaged shipping, please reach out to <a href="mailto:help@latenightcombat.com">help@latenightcombat.com</a> or message <strong>@meepmeepme</strong> on our community Discord and I will make it right.</p>
          </div>
        )}
      </div>
    </div>
  </div>
</CosmosLayout>
